[Unit]
Description=Vera AI Challenge Bot
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/vera-bot
EnvironmentFile=/home/ubuntu/vera-bot/.env
ExecStart=/home/ubuntu/vera-bot/venv/bin/gunicorn main:app -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:8000 --timeout 30
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
